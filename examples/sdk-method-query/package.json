{
  "name": "@liquidium/example-sdk-method-query",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:method-references": "node scripts/generate-method-arg-references.mjs --write",
    "check:method-references": "node scripts/generate-method-arg-references.mjs --check",
    "build": "pnpm run check:method-references && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm run check:method-references && tsc --noEmit"
  },
  "dependencies": {
    "@dynamic-labs/ethereum": "4.83.1",
    "@dynamic-labs/sdk-react-core": "4.83.1",
    "@liquidium/client": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
