{
  "name": "liquidium-sdk",
  "version": "0.0.0",
  "description": "The official SDK for the Liquidium protocol",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.0.0 || >=26.0.0",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "build": "vp run -r build",
    "dev": "vp run -r --parallel dev",
    "clean": "rimraf packages/*/dist",
    "lint": "vp check",
    "lint:fix": "vp check --fix",
    "format": "vp fmt",
    "docs:changelog": "node scripts/generate-docs-changelog.mjs",
    "docs:api": "typedoc",
    "architecture:serve": "env -u OPENAI_API_KEY -u OPENROUTER_API_KEY -u ANTHROPIC_API_KEY -u GEMINI_API_KEY -u OLLAMA_HOST likec4 serve docs/c4 --title \"Liquidium SDK Architecture\" --use-hash-history",
    "architecture:validate": "likec4 validate docs/c4",
    "architecture:build": "likec4 build docs/c4 -o docs/c4/dist --title \"Liquidium SDK Architecture\" --use-hash-history",
    "test": "vp test run",
    "test:e2e": "LIQUIDIUM_LIVE_E2E=1 vp test run --project client-e2e",
    "typecheck": "vp run -r typecheck",
    "release:version": "bun run changeset version && bun run docs:changelog",
    "release": "bun run build && bun run changeset publish"
  },
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@noble/hashes": "^1.8.0",
    "@oxlint/plugins": "1.91.0",
    "@types/node": "^26.1.2",
    "bitcoinjs-lib": "^7.0.1",
    "ecpair": "^3.0.1",
    "likec4": "1.59.2",
    "oxlint": "1.91.0",
    "rimraf": "^6.1.3",
    "tiny-secp256k1": "^2.2.4",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.9.3",
    "viem": "^2.55.10",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.6.7"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ],
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "overrides": {
    "@noble/hashes": "^1.8.0",
    "@dynamic-labs-wallet/primitives": "0.0.337",
    "proxy-addr": "2.0.8",
    "shell-quote": "1.11.0",
    "tinypool": "2.1.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vitest": "5.1.0",
    "vite-plus": "1.5.0"
  }
}
