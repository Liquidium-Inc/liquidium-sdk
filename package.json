{
  "name": "liquidium-sdk",
  "version": "0.0.0",
  "description": "The official SDK for the Liquidium protocol",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo watch build",
    "clean": "rimraf packages/*/dist",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "docs:changelog": "node scripts/generate-docs-changelog.mjs",
    "docs:api": "typedoc",
    "architecture:serve": "env -u OPENAI_API_KEY -u OPENROUTER_API_KEY -u ANTHROPIC_API_KEY -u GEMINI_API_KEY -u OLLAMA_HOST likec4 serve docs/c4 --title \"Liquidium SDK Architecture\" --use-hash-history",
    "architecture:validate": "likec4 validate docs/c4",
    "architecture:build": "likec4 build docs/c4 -o docs/c4/dist --title \"Liquidium SDK Architecture\" --use-hash-history",
    "test": "vitest run",
    "test:e2e": "LIQUIDIUM_LIVE_E2E=1 vitest run --project client-e2e",
    "typecheck": "turbo typecheck",
    "release:version": "pnpm changeset version && pnpm docs:changelog",
    "release": "pnpm run build && pnpm changeset publish"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.2",
    "bitcoinjs-lib": "^7.0.1",
    "ecpair": "^3.0.1",
    "likec4": "1.59.2",
    "rimraf": "^6.1.3",
    "tiny-secp256k1": "^2.2.4",
    "turbo": "^2.10.8",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.9.3",
    "viem": "^2.55.10",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.20.0"
}
