{
  "name": "@liquidium/client",
  "version": "0.12.0",
  "description": "The official client for the Liquidium protocol",
  "keywords": [
    "borrowing",
    "defi",
    "icp",
    "lending",
    "liquidium",
    "sdk"
  ],
  "homepage": "https://liquidium-inc.github.io/liquidium-sdk/",
  "bugs": {
    "url": "https://github.com/Liquidium-Inc/liquidium-sdk/issues"
  },
  "license": "MIT",
  "author": "Liquidium",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liquidium-Inc/liquidium-sdk.git",
    "directory": "packages/client"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit",
    "dev": "vp pack --watch",
    "prepublishOnly": "bun run build && bun run typecheck"
  },
  "dependencies": {
    "@dfinity/utils": "^4.2.1",
    "@icp-sdk/canisters": "^3.6.0",
    "@icp-sdk/core": "^5.4.0",
    "@scure/base": "^2.2.0",
    "bitcoin-address-validation": "^3.0.0",
    "viem": "^2.55.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-mock-extended": "^5.1.1"
  }
}
