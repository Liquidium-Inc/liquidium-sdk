{
  "name": "@liquidium/p2p-evm",
  "version": "0.0.0",
  "description": "Partner SDK for Liquidium peer-to-peer NFT loans on EVM chains",
  "keywords": [
    "liquidium",
    "sdk",
    "defi",
    "evm",
    "nft",
    "borrowing",
    "lending"
  ],
  "homepage": "https://liquidium-inc.github.io/liquidium-sdk/",
  "bugs": {
    "url": "https://github.com/Liquidium-Inc/liquidium-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liquidium-Inc/liquidium-sdk.git",
    "directory": "packages/p2p-evm"
  },
  "author": "Liquidium",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm run build && pnpm run typecheck"
  },
  "dependencies": {
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
